# Ticket Executor — environment template
# Copy to `.env` and fill in. Never commit the filled-in file.
#   cp .env.example .env
#
# Note: this app reads BOTH `.env` and `.env.local` (Next.js loads `.env.local`
# last, so it wins). Pick one file and stick to it to avoid confusion.

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Postgres connection used by Prisma. Point it at a database this app owns —
# never the cluster's `postgres` maintenance database, which other tools share
# and where `prisma migrate reset` would take their schema down with ours.
DATABASE_URL="postgresql://postgres:postgres@localhost:5438/dagent?schema=public"

# ---------------------------------------------------------------------------
# STRONGLY RECOMMENDED
# ---------------------------------------------------------------------------

# Shared login password for the whole app (there are no user accounts).
# Leave EMPTY/unset and the auth gate in `proxy.ts` is disabled entirely —
# fine for a local-only machine, never for anything reachable by others.
APP_ACCESS_PASSWORD=""

# AES-256-GCM key used to encrypt the provider PAT at rest (`lib/crypto.ts`).
# If unset it falls back to DATABASE_URL, then to a hard-coded dev constant.
# Consequence of relying on the fallback: changing DATABASE_URL later makes
# every stored PAT undecryptable (it reads back empty and must be re-entered
# in Settings). Set an explicit random value to avoid that coupling.
SETTINGS_ENC_KEY=""

# NOTE: there is no env var for the repo a run executes in. One provider
# connection spans many projects, so "Root repo" is chosen per ticket on the
# Overview tab and remembered per project — see README §5.

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------

# Redis, used as a read cache in two places: in front of the provider (ticket
# lists, work items, comments, pull requests, projects, iterations) and in front
# of this app's own Postgres for the settings row and the dashboard aggregate.
# Entirely optional: leave it unset and every read goes straight to the source
# exactly as before.
#
# Nothing a write can contradict is served stale — each provider write this app
# makes drops the affected keys — and no credential is ever stored here; the PAT
# stays encrypted in Postgres. The cache is dropped whenever the active
# organization changes, and System Check reports whether Redis is reachable.
#
# Local container:
#   docker run -d --name te-redis -p 6379:6379 redis:7-alpine
# REDIS_URL="redis://localhost:6379"

# Absolute path to the `claude` executable. Only needed when it is not on PATH.
# CLAUDE_BIN="C:\\Users\\<you>\\AppData\\Roaming\\npm\\claude.cmd"

# Extra folder to scan for skills, on top of `~/.claude/skills` and
# `<cwd>/.claude/skills` (see `app/api/skills/route.ts`).
# CLAUDE_SKILLS_DIR="C:\\shared\\claude-skills"

# Path to an MCP config json. When set, the CLI runs with
# `--mcp-config <path> --strict-mcp-config` (only these servers, nothing
# inherited from your user config).
# This is an OVERRIDE: it also disables the app's own MCP handling, so that file
# must itself declare a server for your provider — otherwise the run has no way
# to read the ticket. Leave it unset unless you really want to pin the server
# list; by default the "Manage MCP for me" setting generates the provider server
# per run from the org + token saved in Settings.
# CLAUDE_MCP_CONFIG="C:\\path\\to\\mcp.json"

# Keep this machine's Claude Code plugins loaded during a run. By default the app
# switches every enabled plugin off for the runs it spawns (`--settings` with an
# `enabledPlugins` overlay): a run drives one known skill non-interactively, so a
# plugin's extra skills, slash commands, MCP servers and hooks are context you pay
# for on every turn and never use. Measured here: 26.8k → 11.3k tokens per turn
# with `--strict-mcp-config`, → 6.0k with plugins off. The app's own four skills
# live in ~/.claude/skills and are unaffected. Set this only if a run genuinely
# needs one of your plugins.
# CLAUDE_KEEP_PLUGINS="1"

# Additional raw args appended to every `claude` invocation (space-separated).
# CLAUDE_EXTRA_ARGS=""

# Default provider when no Settings row exists yet: azure-devops | github | jira | gitlab
# Only azure-devops is fully wired; the others are scaffolded.
# TICKET_PROVIDER="azure-devops"

# Fallback ADO project used by org-wide repo/PR lookups when the project can
# not be resolved from the repo (`lib/ado.ts`).
# CLAUDE_DEFAULT_PROJECT=""

# ---- Web Push (lock-screen notifications on iOS / desktop) ----
# Generate once:  npx web-push generate-vapid-keys
# The public half is handed to the browser at subscribe time; the private half
# signs every send and must never leave the server. Rotating the pair
# invalidates every stored PushSubscription — every device must re-enable.
# Leave both empty to keep push off: the watcher then costs nothing.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact for the push service, never shown to the user. mailto: form required.
VAPID_SUBJECT="mailto:you@example.com"

# ---- Slack (Report page → "Send to Slack") ----
# Channel ID the daily report is posted to (Slack → channel → About → Channel ID).
# Posted through the machine's Claude CLI and its authenticated Slack connector (/mcp),
# as the logged-in Slack user. Leave empty to hide the button.
SLACK_REPORT_CHANNEL=""
