# Ticket Executor — environment template
# Copy to `.env` and fill in. Never commit the filled-in file.
#   cp .env.example .env
#
# Note: this app reads BOTH `.env` and `.env.local` (Next.js loads `.env.local`
# last, so it wins). Pick one file and stick to it to avoid confusion.

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Postgres connection used by Prisma. The DB must exist before you run
# `npx prisma migrate dev`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5438/ticket_executor?schema=public"

# ---------------------------------------------------------------------------
# STRONGLY RECOMMENDED
# ---------------------------------------------------------------------------

# Shared login password for the whole app (there are no user accounts).
# Leave EMPTY/unset and the auth gate in `proxy.ts` is disabled entirely —
# fine for a local-only machine, never for anything reachable by others.
APP_ACCESS_PASSWORD=""

# AES-256-GCM key used to encrypt the provider PAT at rest (`lib/crypto.ts`).
# If unset it falls back to DATABASE_URL, then to a hard-coded dev constant.
# Consequence of relying on the fallback: changing DATABASE_URL later makes
# every stored PAT undecryptable (it reads back empty and must be re-entered
# in Settings). Set an explicit random value to avoid that coupling.
SETTINGS_ENC_KEY=""

# NOTE: there is no env var for the repo a run executes in. One provider
# connection spans many projects, so "Root repo" is chosen per ticket on the
# Overview tab and remembered per project — see README §5.

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------

# Absolute path to the `claude` executable. Only needed when it is not on PATH.
# CLAUDE_BIN="C:\\Users\\<you>\\AppData\\Roaming\\npm\\claude.cmd"

# Extra folder to scan for skills, on top of `~/.claude/skills` and
# `<cwd>/.claude/skills` (see `app/api/skills/route.ts`).
# CLAUDE_SKILLS_DIR="C:\\shared\\claude-skills"

# Hard USD ceiling per Claude run (`--max-budget-usd`). Recommended while
# getting familiar with the tool — a runaway two-phase run is not cheap.
# CLAUDE_MAX_BUDGET_USD="5"

# Path to an MCP config json. When set, the CLI runs with
# `--mcp-config <path> --strict-mcp-config` (only these servers, nothing
# inherited from your user config).
# This is an OVERRIDE: it also disables the app's own MCP handling, so that file
# must itself declare a server for your provider — otherwise the run has no way
# to read the ticket. Leave it unset unless you really want to pin the server
# list; by default the "Manage MCP for me" setting generates the provider server
# per run from the org + token saved in Settings.
# CLAUDE_MCP_CONFIG="C:\\path\\to\\mcp.json"

# Additional raw args appended to every `claude` invocation (space-separated).
# CLAUDE_EXTRA_ARGS=""

# Default provider when no Settings row exists yet: azure-devops | github | jira | gitlab
# Only azure-devops is fully wired; the others are scaffolded.
# TICKET_PROVIDER="azure-devops"

# Fallback ADO project used by org-wide repo/PR lookups when the project can
# not be resolved from the repo (`lib/ado.ts`).
# CLAUDE_DEFAULT_PROJECT=""
