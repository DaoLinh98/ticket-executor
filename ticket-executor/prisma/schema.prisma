generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// App settings (single row, id = "default"). Mirrors the Settings modal.
model Setting {
  id             String   @id @default("default")
  provider       String   @default("azure-devops") // azure-devops | github | jira | gitlab
  org            String   @default("")
  pat            String   @default("")
  rootRepo       String   @default("C:\\repos")
  defaultProject String   @default("")
  sprint         String   @default("")
  animatedBackground Boolean @default(true)
  claudeModel    String   @default("claude-sonnet-5")
  claudeEffort   String   @default("medium")
  updatedAt      DateTime @updatedAt
}

// One run of Claude CLI against a ticket. Mirrors the Execution data model.
model Execution {
  id           String    @id @default(cuid())
  adoTicketId  String
  projectName  String
  skillName    String
  status       String    @default("running") // running | completed | failed
  command      String
  resultText   String    @default("")
  errorMessage String    @default("")
  logLines     String    @default("[]") // JSON-encoded LogLine[]
  currentStep  Int       @default(0)
  prUrl        String    @default("")
  branch       String    @default("")
  model        String    @default("")
  effort       String    @default("")
  startedAt    DateTime  @default(now())
  completedAt  DateTime?

  @@index([adoTicketId])
}

// Distinct values ever used for Root Repo / Project / Skill fields, so the
// Overview tab's Combobox can offer them as saved options next time (any
// project/session), not just the ones seen in the current tickets list.
model SavedOption {
  id        String   @id @default(cuid())
  kind      String   // "rootRepo" | "project" | "skill"
  value     String
  createdAt DateTime @default(now())

  @@unique([kind, value])
}

// Remembers which Root Repo a Project was last run with, so opening a
// different ticket that shares the same Project auto-selects that Root Repo.
model RootRepoProjectMap {
  id        String   @id @default(cuid())
  project   String   @unique
  rootRepo  String
  updatedAt DateTime @updatedAt
}
