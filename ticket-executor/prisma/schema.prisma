generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// App settings (single row, id = "default"). Mirrors the Settings modal.
model Setting {
  id             String   @id @default("default")
  provider       String   @default("azure-devops") // azure-devops | github | jira | gitlab
  // false → the 3D reactor backdrop is not rendered at all (AppReactor unmounts
  // it, disposing the WebGL context). Not a "pause": the setting means no
  // backdrop, so the globe and the star field go too.
  animatedBackground Boolean @default(true)
  // true (default) → the lightning-bolt effect fires on clicks and self-strikes
  // into every mounted spinner (running buttons). false → both are suppressed;
  // the effect layer stays mounted but never emits a bolt.
  clickEffects   Boolean  @default(true)
  // true (default) → the spinning conic-gradient "energy ring" sweeps around
  // every button/tab/panel border (lib/ui.ts ringBorder). false → the same
  // borders paint as a flat line: the app sets --te-ring-image globally, which
  // is the override hook ringBorder already reads.
  ringAnimation  Boolean  @default(true)
  // Auto-implementation mode. true → the original one-shot flow (implement-ticket-v2,
  // runs to a PR without stopping). false → the two-phase plan-review flow
  // (implement-ticket-v3, parks for plan approval before touching code).
  autoImplement  Boolean  @default(true)
  // Auto-resolve-code-review mode — same on/off split as autoImplement, but for
  // the Resolve Review flow. true → the original one-shot flow (fix-code-review-v2,
  // resolves all threads without stopping). false → the two-phase plan-review flow
  // (fix-code-review-v3, parks for plan approval before touching code).
  autoResolveCodeReview Boolean @default(true)
  scope          String   @default("team") // team | personal
  personalAccount String  @default("") // email or display name to filter by when scope = "personal"
  concurrentRuns Int      @default(2) // cap for batch "Run selected" concurrency
  // Dashboard ROI inputs. hourlyRateUsd = 0 (default) hides the ROI tile entirely,
  // since a made-up rate would be worse than no number at all. hoursPerStoryPoint
  // converts point-sized tickets to hours when the provider has no hour estimate.
  hourlyRateUsd  Float    @default(0)
  hoursPerStoryPoint Float @default(6)
  // Insert an independent review node between `implement` and `publish` in the
  // two-phase flow, with a bounded fix loop behind it. Off by default on
  // purpose: it costs roughly one extra review turn per run plus whatever the
  // fixes cost, and whether that pays for itself is a question the dashboard
  // answers (firstPassRate / reworkFactor against costPerShippedTicket), not one
  // a default should presume. Flip it, run a batch, compare.
  evaluateBeforePublish Boolean @default(false)
  // true → multi-ticket mode: multi-select/batch runs allowed, each execution
  // isolated in its own git worktree. false → single-ticket mode: only one
  // ticket may run at a time, and it runs directly in rootRepo (no worktree).
  multiTicketMode Boolean @default(true)
  // true (default) → the app hands the Claude CLI a generated MCP config for the
  // selected provider, built from this provider's stored org + PAT, so a fresh
  // install needs no manual `claude mcp add`. It yields to a server the user
  // configured themselves. false → the app never touches MCP; preflight only
  // verifies what the machine already has.
  manageMcp      Boolean  @default(true)
  // ---- the git author a run commits as ----
  //
  // Needed because the app now executes inside a container, where there is no
  // developer's `~/.gitconfig` to inherit: without an author `git commit` fails
  // outright at the first implementing node, after the run has already been paid
  // for. So it is asked for once and remembered.
  //
  // Empty is a legitimate state — with the app on a developer's own machine the
  // machine's git identity is the right one, and writing over it would be worse
  // than leaving it alone. See `applyGitIdentity()` in lib/execution/runner.ts.
  gitUserName    String   @default("")
  gitUserEmail   String   @default("")
  // No new run may start before this instant. Written by the harness, not by a
  // person: the Claude account is shared by every run on this machine, so the
  // moment one turn reports a spent quota, every other ticket would spend a
  // spawn to be told the same thing. Null (or past) is the normal state.
  //
  // It is deliberately a refusal in `admissionDenial()` rather than a check in
  // the scheduler — a limit applies to a button press exactly as it applies to a
  // scheduled run, and a second gate would be a second place to drift.
  agentPausedUntil DateTime?
  updatedAt      DateTime @updatedAt
}

// One connection to one organization (org/repo URL + PAT, encrypted at rest).
//
// A provider holds as many of these as the operator works with — one ADO
// organization per client, say — and exactly one of them is `isActive`, which
// is the one every consumer runs as (`resolveCredential()`). Switching the
// active row in the header re-points ticket, project, sprint and review loading
// at that organization without touching a single call site.
model ProviderCredential {
  id        String   @id @default(cuid())
  provider  String // azure-devops | github | jira | gitlab
  // Operator-given name for the connection. Empty falls back to the name
  // derived from the URL (`connectionLabel()` in lib/providers.ts).
  label     String   @default("")
  org       String   @default("")
  pat       String   @default("")
  // The connection this provider currently runs as. At most one true per
  // provider — `setActiveConnection()` clears the others in the same
  // transaction that sets this one.
  isActive  Boolean  @default(false)
  // Who the developer *is* inside this organization. Work is handed out per
  // organization account, so the same person is ken.nguyen@emesoft.net in one
  // client's ADO and somebody else entirely in the next — which is why this
  // cannot live on `Setting`: one global value would answer the question wrong
  // the moment the header switches connection.
  //
  // Empty is a legitimate state: a connection used only for browsing a team's
  // board needs no identity, and every consumer treats "no identity" as "do not
  // filter" rather than as "match nobody".
  //
  // Email is the reliable key (`Ticket.assigneeEmail`); the display name is the
  // fallback for providers and work items that only carry a name.
  identityEmail String @default("")
  identityName  String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, org])
  @@index([provider])
}

// One execution of one graph against one ticket. A Run owns no agent output of
// its own: everything an agent produced belongs to a Step, everything a human
// can read belongs to an Artifact, and every routing decision belongs to a
// Transition. The Run row only holds what identifies the run and where it is.
model Run {
  id           String    @id @default(cuid())
  ticketId     String
  // Provider deep link to the work item, as the skills receive it. Empty when
  // the caller had no URL — the prompt then falls back to the raw id.
  ticketUrl    String    @default("")
  // Ticket provider this run targeted (azure-devops | github | jira | gitlab).
  // Persisted per-run so the dashboard can group/filter by provider (the global
  // Setting.provider only reflects the current selection, not each run's).
  provider     String    @default("")
  // The organization URL the run authenticated against, snapshotted from the
  // active ProviderCredential. Persisted for the same reason as `provider`: the
  // dashboard scopes history to the organization the header is switched to, and
  // the active connection only says which one that is *now*.
  org          String    @default("")
  project      String
  // The project's real working copy, and the worktree the run actually executes
  // in. They are equal when the run was not isolated (single-ticket mode).
  rootRepo     String    @default("")
  worktreePath String    @default("")
  // Which graph shape is being driven (implement-v3, fix-review-v2, …). The graph
  // itself is code; this is the key that resolves it, so a run parked before a
  // restart resumes on the same shape it started on.
  graphId      String
  // The skill the graph drives. An input to the run, kept on the row because the
  // dashboard groups and compares by it.
  skill        String    @default("")
  // Promoted out of the nodes' structured output when they report it, because
  // every one of these has a consumer that must not have to open a Step row:
  // prUrl (Result tab, Resolve Review tab, delivery funnel), branch (Result tab),
  // resultText (the run summary shown when a run finishes). None of them is
  // sniffed out of the log any more — they are contract fields.
  prUrl        String    @default("")
  branch       String    @default("")
  resultText   String    @default("")
  // The single source of truth for where the run is. `phase`/`planStatus`-style
  // derived flags are gone: state + currentNodeId is the whole answer.
  state        String    @default("running") // running | waiting | succeeded | failed | cancelled
  currentNodeId String   @default("")
  // Why a run ended somewhere other than plain success: "" | cancelled |
  // plan-rejected | blocked | hop-limit | needs-review. `cancelled` and
  // `plan-rejected` are human decisions and must never be scored as agent failures.
  endReason    String    @default("")
  errorMessage String    @default("")
  // Claude CLI session the run's turns share, so a later node can --resume the
  // context an earlier one built.
  sessionId    String    @default("")
  // State channels: nodeId → that node's validated structured output. Append-only;
  // a node only ever writes its own key. This is what edges read.
  channels     Json      @default("{}")
  // Transitions this run has taken. Persisted rather than counted in a local
  // variable because drive() is re-entered on every gate resolution and on every
  // crash resume — a counter that resets at each of those is not a loop guard.
  hops         Int       @default(0)
  // nodeId → how many times that node has been entered. The accounting a bounded
  // cycle reads ("stop after two fix attempts"); it used to live only in memory,
  // so a restart silently reset every cycle's count back to zero.
  visits       Json      @default("{}")
  model        String    @default("")
  effort       String    @default("")
  // The team's own estimate for this ticket, in hours, snapshotted when the run
  // started (0 = the ticket was never sized). Snapshotted rather than read live
  // because re-estimating a ticket later must not rewrite past runs' history.
  estimateHours Float    @default(0)
  // Commit the worktree branched from. The run's whole change set is the diff of
  // HEAD against this, computed by the harness (free, no tokens) rather than
  // asked of the agent.
  baseSha      String    @default("")
  // Scalar summary of that diff, denormalized when the run ends so the dashboard
  // can aggregate change size without loading the diff blob (which lives in an
  // Artifact of kind "diff").
  filesTouched Int       @default(0)
  linesAdded   Int       @default(0)
  linesDeleted Int       @default(0)
  // Set while the run waits at a gate and cleared on resume, with the elapsed
  // time folded into humanWaitMs — so "the agent was computing" and "a human
  // hadn't answered" stay separable across however many gate rounds happen.
  parkedAt     DateTime?
  humanWaitMs  Int       @default(0)
  // Set while the run waits for the Claude account's usage limit to reset, and
  // cleared on resume. Three columns rather than reusing the gate's two, because
  // a gate waits for a person and this waits for a clock:
  //   resumeAt    — when the sweep may re-enter the node. Null for a gate park,
  //                 which is how the two are told apart when the wait is banked.
  //   limitWaitMs — the elapsed time, kept out of humanWaitMs so the dashboard's
  //                 "human wait" stays a fact about the team and not about a bill.
  //   limitParks  — how many times this run has been cut off. The ceiling
  //                 (MAX_LIMIT_PARKS) that stops a run parking against a quota
  //                 that never recovers.
  resumeAt     DateTime?
  limitWaitMs  Int       @default(0)
  limitParks   Int       @default(0)
  // Set when the run had to be rebuilt from this row because the in-process
  // state was lost (server restart) — a session a bare terminal would have dropped.
  resumedAfterRestart Boolean @default(false)
  startedAt    DateTime  @default(now())
  endedAt      DateTime?

  steps       Step[]
  artifacts   Artifact[]
  transitions Transition[]

  @@index([ticketId])
  @@index([startedAt])
  // The sweep that wakes limit-parked runs asks this on every scheduler tick.
  @@index([resumeAt])
}

// One *attempt* at one node. A node re-entered by a cycle (or resumed after a
// crash) produces another Step with attempt + 1 rather than overwriting the
// first — the history of what was tried is the point.
model Step {
  id           String    @id @default(cuid())
  runId        String
  run          Run       @relation(fields: [runId], references: [id], onDelete: Cascade)
  nodeId       String
  label        String    @default("")
  attempt      Int       @default(1)
  // Copied from the node definition so recovery can decide what to do with a
  // Step still marked `running` without having to resolve the graph first:
  // pure → rerun, local → resume, external → never auto-retry.
  effects      String    @default("pure") // pure | local | external
  status       String    @default("running") // running | succeeded | failed | abandoned
  // The node's validated structured output (agent nodes: result.structured_output).
  output       Json      @default("{}")
  errorMessage String    @default("")
  logLines     Json      @default("[]")
  // Lease held while a process is driving this step, so two processes cannot
  // claim the same node after a restart.
  claimedAt    DateTime?
  costUsd      Float     @default(0)
  inputTokens  Int       @default(0)
  outputTokens Int       @default(0)
  cacheReadTokens Int    @default(0)
  cacheCreationTokens Int @default(0)
  numTurns     Int       @default(0)
  durationMs   Int       @default(0)
  startedAt    DateTime  @default(now())
  endedAt      DateTime?

  @@index([runId])
  @@unique([runId, nodeId, attempt])
}

// Something a human reads or edits. The plan used to live only as .te/plan.md on
// disk — a filesystem side channel the harness had to guess at. It is a first
// class row now; the file is just where the agent drafts it.
model Artifact {
  id        String   @id @default(cuid())
  runId     String
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  kind      String   // plan | feedback | diff
  // A reviewer's edit creates a new version instead of overwriting the agent's,
  // so "what the agent proposed" and "what the human approved" stay comparable.
  version   Int      @default(1)
  body      String
  editedBy  String   @default("agent") // agent | human
  createdAt DateTime @default(now())

  @@index([runId, kind])
  @@unique([runId, kind, version])
}

// Why the harness went from one node to the next. Four of these explain a run
// better than a thousand lines of tool log, and they are what makes a graph
// auditable rather than merely automated.
model Transition {
  id        String   @id @default(cuid())
  runId     String
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  seq       Int
  fromNode  String
  toNode    String   // a node id, or "END" / "FAIL"
  reason    String   @default("")
  createdAt DateTime @default(now())

  @@index([runId, seq])
}

// A run request the preflight checks rejected before the Claude CLI was ever
// spawned. Recorded because "the run that never had to burn tokens" is only
// visible as a metric if the refusal is persisted — the request itself just
// returns a 400 and disappears.
model BlockedAttempt {
  id          String   @id @default(cuid())
  ticketId    String
  provider    String   @default("")
  org         String   @default("")
  projectName String   @default("")
  // root-repo | agent-access        — preflight refused it
  // duplicate-ticket                — that ticket already has a run in flight
  // single-ticket-mode              — another ticket holds the only slot
  // concurrency-cap                 — Setting.concurrentRuns is already reached
  // unknown-skill                   — the caller asked for a skill no graph serves
  // missing-skill                   — a node's skill is not installed on this machine
  reason      String
  detail      String   @default("")
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// Distinct values ever used for Root Repo / Project / Skill fields, so the
// Overview tab's Combobox can offer them as saved options next time (any
// project/session), not just the ones seen in the current tickets list.
model SavedOption {
  id        String   @id @default(cuid())
  kind      String   // "rootRepo" | "project" | "skill"
  value     String
  createdAt DateTime @default(now())

  @@unique([kind, value])
}

// Remembers which Root Repo a Project was last run with, so opening a
// different ticket that shares the same Project auto-selects that Root Repo.
//
// Keyed by connection, not by project name alone. Project names are only unique
// inside one organization, and two clients both having a project called "Web" is
// ordinary — with a bare `project` key the second connection would silently
// overwrite the first, and the scheduler would then check out the wrong clone at
// two in the morning.
model RootRepoProjectMap {
  id        String   @id @default(cuid())
  provider  String   @default("")
  org       String   @default("")
  project   String
  rootRepo  String
  updatedAt DateTime @updatedAt

  @@unique([provider, org, project])
}

// Which pull request a ticket's review lives on, once anything has resolved it.
//
// `Run.prUrl` already answers this for a PR **this app opened**. It answers
// nothing for a PR a human opened, and that gap is expensive: resolving a work
// item's PR from scratch at the provider costs a work-item read with relations
// expanded, then a repository read to verify the link, before the PR itself —
// four calls where a known URL costs two. The review bell asks about the same
// tickets every poll, so an unrecorded PR pays that difference forever.
//
// So every path that successfully resolves one writes it here, and the bell
// reads it back. Deliberately a **cache with no expiry rather than a mirror**:
// nothing is served *from* this row, it only shortens a lookup. A URL that has
// gone stale — repository renamed, PR deleted — simply fails its read and the
// caller falls through to the full resolution, which is the same fallback a
// stale `Run.prUrl` already relies on. That is why there is no TTL to tune and
// no invalidation to get wrong.
model TicketPullRequest {
  id        String   @id @default(cuid())
  provider  String
  ticketId  String
  prUrl     String
  updatedAt DateTime @updatedAt

  @@unique([provider, ticketId])
}

// What the harness has learned about one repository, accumulated across runs.
//
// A run already discovers durable facts about the repo it works in — which test
// command actually exists, where a generated file must not be edited, the
// convention a reviewer keeps re-raising — and then throws all of it away: the
// worktree is removed, the session ends, and the next ticket rediscovers the
// same thing at full token price. This table is the only place that survives
// both.
//
// It is written from **contract fields**, not from prose: the delivering and
// reviewing nodes each answer a `lessons` array in their JSON Schema (see
// graph/schemas.ts), so nothing here comes from scraping a log. That is also why
// there is no `learn` node — an extra node would change every graph's shape
// (and therefore its `graphId`), cost an extra agent turn per run, and be
// impossible to fit into the one-shot graph, which publishes inside its only
// node.
//
// Scoped by `rootRepo` because that is what a lesson is *about*. `fingerprint`
// is the normalized text and carries the uniqueness: the same lesson learned by
// ten runs is one row with `hits = 10`, which is also the ranking signal when
// more notes exist than may be injected into a prompt.
//
// `active` exists so a wrong lesson can be retired without deleting the evidence
// that it was learned. Nothing routes on this table and no run fails because of
// it — it only shapes a prompt.
model KnowledgeNote {
  id          String   @id @default(cuid())
  rootRepo    String
  // "implement" | "review" — which flow family reported it. Kept so a review
  // convention is not injected into a plan prompt that has no PR in sight.
  scope       String
  text        String
  fingerprint String
  active      Boolean  @default(true)
  hits        Int      @default(1)
  firstRunId  String
  lastRunId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([rootRepo, fingerprint])
  @@index([rootRepo, active])
}

// One triage turn over one developer's slice of one sprint.
//
// Not a Run: triage writes nothing — no file, no comment, no story point — so it
// has no worktree, no branch and nothing for admission control to protect. What
// it keeps from a run is the part that matters, a declared output contract, so
// the answer is data the planner acts on rather than a table a human retypes.
//
// Persisted rather than held in memory because the plan built from it is acted
// on for a fortnight: "why is #123 marked blocked" must stay answerable long
// after the turn's log is gone.
model SprintTriage {
  id            String   @id @default(cuid())
  provider      String
  org           String
  project       String
  sprint        String
  // Whose slice was triaged. Two developers on one sprint are two triages.
  identityEmail String   @default("")
  // Exactly the work items the turn was told to review. Kept so a result can be
  // read back without re-deriving which tickets were in the sprint that day.
  ticketIds     String[]
  status        String   @default("running") // running | succeeded | failed
  // The validated structured output (see TRIAGE_OUTPUT in lib/execution/triage.ts).
  result        Json     @default("{}")
  errorMessage  String   @default("")
  costUsd       Float    @default(0)
  createdAt     DateTime @default(now())
  endedAt       DateTime?

  @@index([provider, org, project, sprint])
}

// The developer's plan for one sprint: the queue the agent works through, and
// the calendar its finished work is revealed on.
//
// Persisted rather than recomputed on every page load, because the scheduler
// acts on it unattended. Three weeks later "why did it run #123 on Tuesday" has
// to be answerable from a row, not by re-running an algorithm over data that has
// since changed — the same reason BlockedAttempt exists.
//
// A plan is `draft` until a human activates it. Nothing is ever scheduled from a
// draft: the step after activation spends money and writes to the tracker.
model SprintPlan {
  id            String   @id @default(cuid())
  provider      String
  org           String
  project       String
  sprint        String
  identityEmail String   @default("")
  status        String   @default("draft") // draft | active | archived
  // The iteration window the calendar was laid out on, snapshotted: a provider
  // that shifts a sprint's dates must not silently re-date an active plan.
  startDate     String   @default("")
  finishDate    String   @default("")
  // The pace this plan was built with, snapshotted for the same reason — the
  // Settings values may move on, and an active plan keeps the shape it was
  // approved on.
  pointsPerDay     Float @default(2)
  hoursPerDay      Float @default(8)
  hoursPerPoint    Float @default(4)
  maxTicketsPerDay Int   @default(0)
  // Whether this plan was built from the developer's assigned work wherever it
  // lives (board, backlog, an earlier iteration) or from the iteration alone.
  // Stored rather than re-decided per read: the scheduler re-reads ownership on
  // every tick and must ask the same question the plan was approved on, or a
  // ticket the plan legitimately contains reads as one that left the sprint.
  includeWider  Boolean  @default(true)
  // The two halves of automation, separately switchable on purpose: working
  // ahead is cheap to undo (a branch nobody has seen), while releasing is
  // outward-facing (a reviewer is notified, a work item changes state). A
  // developer who wants the agent to work overnight but wants to press the
  // button on what reaches their reviewer sets exactly that.
  autoImplement Boolean  @default(false)
  autoRelease   Boolean  @default(false)
  // The third half, and it is a third for the same reason release is a second:
  // resolving a review writes on a pull request a reviewer is already reading —
  // replies and resolved threads, under the developer's name. Somebody happy to
  // let the agent work overnight is not automatically happy to let it answer
  // their reviewer, so it gets its own switch rather than riding on autoRelease.
  autoResolveReview Boolean @default(false)
  // Reviewers every pull request from this plan is assigned when it is released.
  // Held per plan rather than per ticket: the team a sprint is delivered to is
  // the same team all fortnight.
  reviewers     String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items         PlannedTicket[]

  @@unique([provider, org, project, sprint, identityEmail])
}

// One ticket's place in a plan, and what has actually happened to it.
//
// The two schedules are two columns and neither is derived from the other:
// `implementOrder` is a queue the agent works down as fast as the machine
// allows, `releaseDay` is a calendar a reviewer receives work on.
//
// The release half is three booleans rather than one `released` flag because the
// three provider writes can diverge — a draft can be published while assigning a
// reviewer fails — and a single flag would record that as either a success or a
// failure, both of which would be wrong.
model PlannedTicket {
  id             String     @id @default(cuid())
  planId         String
  plan           SprintPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  ticketId       String
  title          String     @default("")
  implementOrder Int        @default(0)
  points         Float      @default(0)
  estimateHours  Float      @default(0)
  // ISO working day (YYYY-MM-DD). Empty means the pace never reached this ticket
  // inside the sprint — a finding, not a rounding error.
  releaseDay     String     @default("")
  // Triage said a person has to answer something first. Planned and counted, but
  // never eligible for an automatic run.
  blocked        Boolean    @default(false)
  // The developer overrode `blocked` and let this ticket run anyway.
  //
  // A separate column rather than clearing `blocked`, because the two are
  // different facts and both have to survive: `blocked` is what triage found,
  // and every rebuild recomputes it from the newest triage, so an override
  // written into it would be erased by the next "Build plan". This one is never
  // touched by a rebuild — the developer said it once, about a ticket, and it
  // holds until they say otherwise.
  //
  // It exists because "needs clarification" is not always "cannot start": the
  // question is often one the codebase already answers, and waiting for a BA to
  // confirm what the repo makes obvious is a day lost for nothing.
  unblockedByUser Boolean   @default(false)
  // Where the developer's claim on this ticket stands — see `lib/sprintClaim.ts`.
  // mine | handed-off | dropped. The row outlives the assignment that created
  // it: a ticket moved to QA under somebody else's name is still part of the
  // sprint the developer delivered, and deleting it would make a good sprint
  // report as a quiet one.
  claim          String     @default("mine")
  assigneeNow    String     @default("")
  implementState String     @default("pending") // pending | running | implemented | failed | skipped
  // The run that implemented it, when one has.
  runId          String     @default("")
  prUrl          String     @default("")
  // ---- release: one column per provider write ----
  prPublished    Boolean    @default(false)
  reviewersSet   Boolean    @default(false)
  statusMoved    Boolean    @default(false)
  releasedAt     DateTime?
  releaseError   String     @default("")
  // ---- code review: the third lane, and it runs after release ----
  //
  // Beside implementState rather than folded into it. They are facts about
  // different moments: a released ticket whose review is being resolved is
  // still released, and rounding two lanes into one column is exactly what left
  // a released ticket labelled "Draft PR" until stateOf() was split.
  //
  //   idle         nothing seen yet, or nothing to do
  //   detected     open comments found, waiting for a slot
  //   running      a fix-code-review run is in flight
  //   resolved     the run finished; threads may still be open on purpose
  //   failed       the run did not finish
  //   needs-human  the round ceiling was reached — a person has to look
  reviewState     String    @default("idle")
  reviewRunId     String    @default("")
  // Open threads at the last scan, and how the last run answered them.
  openComments    Int       @default(0)
  threadsReplied  Int       @default(0)
  threadsResolved Int       @default(0)
  // The watermark that stops the loop. The skill deliberately leaves threads it
  // judged invalid or architectural OPEN, with a reply — so "unresolved > 0" is
  // a normal end state, not a trigger. Only a comment newer than this, written
  // by somebody other than us, is new work.
  lastCommentAt   String    @default("")
  // How many times this ticket has been round the fix loop. A ceiling, because
  // three rounds without closure means the finding is architectural, and a
  // fourth round will not close it either.
  reviewRounds    Int       @default(0)
  reviewedAt      DateTime?
  reviewError     String    @default("")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([planId, ticketId])
  @@index([releaseDay])
  @@index([claim])
  @@index([reviewState])
}

// Every decision the scheduler made, including the ones to do nothing.
//
// Same reasoning as BlockedAttempt: an automatic system is only debuggable if
// its refusals are as visible as its actions. "Why did nothing run last night"
// is answered by rows saying which ticket was considered and what stopped it —
// never by the server's console output, which is gone by morning.
model AutomationEvent {
  id        String   @id @default(cuid())
  planId    String   @default("")
  ticketId  String   @default("")
  action    String   // implement | release
  outcome   String   // started | done | skipped | failed
  // Short machine-readable cause: blocked-by-triage, not-due, already-running,
  // admission-refused, no-pr, provider-error, …
  reason    String   @default("")
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([planId])
}

// One iOS/desktop device that asked to be told about notifications while the
// app is closed.
//
// Per device, not per user: this app has no user accounts (one shared password,
// see lib/auth.ts), and a push subscription is issued by the browser to one
// installed copy of the app. The endpoint the push service hands back is the
// address, so it is the identity — re-subscribing on the same device returns
// the same endpoint and must update the keys rather than add a second row.
//
// Rows are deleted, not marked dead, when the push service answers 404/410:
// that response means the subscription no longer exists anywhere, so keeping it
// would only buy a guaranteed failure on every future send.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  // What the device called itself when it subscribed, so the Settings list can
  // say "iPhone" rather than a 200-character endpoint URL.
  label     String   @default("")
  createdAt DateTime @default(now())
}

// The notifications already pushed, keyed by the same key the bell dedupes on.
//
// The watcher recomputes the whole current notification set on every tick — the
// sources are all "what is true now", not "what changed" — so without a record
// of what was already sent, one unresolved review comment would light up the
// lock screen every minute until somebody answered it.
//
// Persisted rather than held in memory because the opposite failure is the
// costly one: a restart that forgot would re-push everything at once, at 3am.
model PushDelivery {
  key    String   @id
  sentAt DateTime @default(now())

  @@index([sentAt])
}
